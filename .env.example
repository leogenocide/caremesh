# CareMesh Environment Configuration
PORT=3001
NODE_ENV=development
VITE_API_URL=http://localhost:3001/api

# Real Email Delivery (SMTP / Gmail App Password)
# To send actual verification codes to real Gmail/email inboxes:
# 1. Enable 2-Step Verification on your Google account (https://myaccount.google.com/security)
# 2. Generate a 16-character App Password (https://myaccount.google.com/apppasswords)
# 3. Fill in your Gmail and 16-char App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="CareMesh Community" <your_email@gmail.com>

# Google Single Sign-On (Optional)
VITE_GOOGLE_CLIENT_ID=
